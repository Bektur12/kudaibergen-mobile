import { useState } from "react";
import { C } from "@/components/ui";

// Buyer screens
import HomeScreen from "@/screens/buyer/HomeScreen";
import SearchScreen from "@/screens/buyer/SearchScreen";
import MapScreen from "@/screens/buyer/MapScreen";
import MessagesScreen from "@/screens/buyer/MessagesScreen";
import BuyerProfile from "@/screens/buyer/ProfileScreen";

// Seller screens
import DashboardScreen from "@/screens/seller/DashboardScreen";
import InventoryScreen from "@/screens/seller/InventoryScreen";
import AnalyticsScreen from "@/screens/seller/AnalyticsScreen";
import SellerMessagesScreen from "@/screens/buyer/MessagesScreen"; // same layout
import SellerProfile from "@/screens/seller/SellerProfileScreen";

// Shared
import ChatDetailScreen from "@/screens/ChatDetailScreen";

type Role = "buyer" | "seller";

function TabBar({
  tabs,
  active,
  onSelect,
}: {
  tabs: { id: string; label: string; icon: (active: boolean) => React.ReactNode }[];
  active: string;
  onSelect: (id: string) => void;
}) {
  return (
    <div style={{
      background: "#fff",
      borderTop: `1px solid ${C.border}`,
      display: "flex",
      padding: "6px 0 20px",
      flexShrink: 0,
    }}>
      {tabs.map((tab) => {
        const isActive = active === tab.id;
        return (
          <button
            key={tab.id}
            onClick={() => onSelect(tab.id)}
            style={{
              flex: 1,
              background: "none",
              border: "none",
              cursor: "pointer",
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              gap: 3,
              padding: "4px 0",
            }}
          >
            {tab.icon(isActive)}
            <span style={{
              fontFamily: "Inter",
              fontSize: 10,
              fontWeight: isActive ? 700 : 400,
              color: isActive ? C.primary : C.textTertiary,
            }}>{tab.label}</span>
          </button>
        );
      })}
    </div>
  );
}

// ---- Icon components ----
const icons = {
  home: (a: boolean) => <svg width="22" height="22" viewBox="0 0 24 24" fill={a ? C.primary : "none"} stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>,
  search: (a: boolean) => <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>,
  map: (a: boolean) => <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="1,6 1,22 8,18 16,22 23,18 23,2 16,6 8,2"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>,
  chat: (a: boolean, badge?: number) => (
    <div style={{ position: "relative" }}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      {badge && badge > 0 && <span style={{ position: "absolute", top: -4, right: -4, background: C.error, color: "#fff", borderRadius: 999, minWidth: 14, height: 14, display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "Inter", fontSize: 9, fontWeight: 700, padding: "0 3px" }}>{badge}</span>}
    </div>
  ),
  user: (a: boolean) => <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>,
  grid: (a: boolean) => <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>,
  box: (a: boolean) => <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>,
  chart: (a: boolean) => <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={a ? C.primary : C.textTertiary} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>,
};

const BUYER_TABS = [
  { id: "home", label: "Главная", icon: icons.home },
  { id: "search", label: "Поиск", icon: icons.search },
  { id: "map", label: "Карта", icon: icons.map },
  { id: "messages", label: "Чаты", icon: (a: boolean) => icons.chat(a, 3) },
  { id: "profile", label: "Профиль", icon: icons.user },
];

const SELLER_TABS = [
  { id: "dashboard", label: "Запросы", icon: icons.grid },
  { id: "inventory", label: "Товары", icon: icons.box },
  { id: "analytics", label: "Аналитика", icon: icons.chart },
  { id: "messages", label: "Чаты", icon: (a: boolean) => icons.chat(a, 2) },
  { id: "profile", label: "Профиль", icon: icons.user },
];

export default function App() {
  const [role, setRole] = useState<Role>("buyer");
  const [buyerTab, setBuyerTab] = useState("home");
  const [sellerTab, setSellerTab] = useState("dashboard");
  const [chatOpen, setChatOpen] = useState(false);

  const buyerScreens: Record<string, React.ReactNode> = {
    home: <HomeScreen onNavigate={setBuyerTab} onOpenChat={() => setChatOpen(true)} />,
    search: <SearchScreen onOpenChat={() => setChatOpen(true)} />,
    map: <MapScreen />,
    messages: <MessagesScreen onOpenChat={() => setChatOpen(true)} />,
    profile: <BuyerProfile />,
  };

  const sellerScreens: Record<string, React.ReactNode> = {
    dashboard: <DashboardScreen onOpenChat={() => setChatOpen(true)} />,
    inventory: <InventoryScreen />,
    analytics: <AnalyticsScreen />,
    messages: <SellerMessagesScreen onOpenChat={() => setChatOpen(true)} />,
    profile: <SellerProfile />,
  };

  return (
    <div style={{ display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", minHeight: "100vh", padding: 20 }}>
      {/* Role toggle — outside the phone */}
      <div style={{
        display: "flex",
        background: "rgba(255,255,255,0.12)",
        borderRadius: 12,
        padding: 4,
        marginBottom: 16,
        gap: 4,
      }}>
        {(["buyer", "seller"] as Role[]).map((r) => (
          <button
            key={r}
            onClick={() => setRole(r)}
            style={{
              background: role === r ? C.primary : "transparent",
              color: role === r ? "#fff" : "rgba(255,255,255,0.7)",
              border: "none",
              borderRadius: 9,
              padding: "8px 20px",
              fontFamily: "Inter",
              fontWeight: 700,
              fontSize: 13,
              cursor: "pointer",
              transition: "all 0.2s",
            }}
          >
            {r === "buyer" ? "🛒 Покупатель" : "🏪 Продавец"}
          </button>
        ))}
      </div>

      {/* Phone frame */}
      <div style={{
        width: 390,
        height: 844,
        background: C.bg,
        borderRadius: 44,
        overflow: "hidden",
        display: "flex",
        flexDirection: "column",
        boxShadow: "0 40px 100px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.08)",
        position: "relative",
      }}>
        {/* Status bar */}
        <div style={{ background: role === "buyer" ? C.surface : C.primary, padding: "12px 24px 8px", display: "flex", justifyContent: "space-between", alignItems: "center", flexShrink: 0 }}>
          <span style={{ fontFamily: "Inter", fontWeight: 700, fontSize: 13, color: role === "seller" ? "#fff" : C.textPrimary }}>9:41</span>
          <div style={{ display: "flex", gap: 5, alignItems: "center" }}>
            {/* Signal bars */}
            <svg width="16" height="12" viewBox="0 0 16 12" fill={role === "seller" ? "rgba(255,255,255,0.9)" : C.textPrimary}>
              <rect x="0" y="4" width="2.5" height="8" rx="1"/>
              <rect x="4.5" y="2.5" width="2.5" height="9.5" rx="1"/>
              <rect x="9" y="0" width="2.5" height="12" rx="1"/>
              <rect x="13.5" y="0" width="2.5" height="12" rx="1" opacity="0.3"/>
            </svg>
            {/* Battery */}
            <svg width="25" height="12" viewBox="0 0 25 12" fill="none">
              <rect x="0.5" y="1.5" width="20" height="9" rx="2" stroke={role === "seller" ? "rgba(255,255,255,0.9)" : C.textPrimary} strokeWidth="1"/>
              <rect x="1.5" y="2.5" width="16" height="7" rx="1" fill={role === "seller" ? "rgba(255,255,255,0.9)" : C.textPrimary}/>
              <path d="M22 4v4c.9-.5 1.5-1.2 1.5-2s-.6-1.5-1.5-2z" fill={role === "seller" ? "rgba(255,255,255,0.9)" : C.textPrimary}/>
            </svg>
          </div>
        </div>

        {/* Content */}
        <div style={{ flex: 1, overflow: "hidden", position: "relative" }}>
          {chatOpen ? (
            <ChatDetailScreen onBack={() => setChatOpen(false)} />
          ) : role === "buyer" ? (
            buyerScreens[buyerTab]
          ) : (
            sellerScreens[sellerTab]
          )}
        </div>

        {/* Tab bar */}
        {!chatOpen && (
          <TabBar
            tabs={role === "buyer" ? BUYER_TABS : SELLER_TABS}
            active={role === "buyer" ? buyerTab : sellerTab}
            onSelect={role === "buyer" ? setBuyerTab : setSellerTab}
          />
        )}
      </div>
    </div>
  );
}
