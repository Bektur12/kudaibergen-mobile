{
	"expo": {
		"name": "kudaibergen-rn",
		"slug": "kudaibergen-rn",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "kudaibergenrn",
		"userInterfaceStyle": "light",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "com.bekturillo.kudaibergenrn"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#FFFFFF",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.bekturillo.kudaibergenrn"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#FFFFFF",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 76
				}
			],
			"expo-secure-store",
			[
				"expo-audio",
				{
					"microphonePermission": "Разрешите доступ к микрофону, чтобы отправлять голосовые сообщения в чате"
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
